// 1) subsequences of string

    void solve(string s,int index,vector<string>&ans,string output){
        if(index>=s.length()){
           if(output.length>0) ans.push_back(output);
            return;
        }
      
        solve(s,index+1,ans,output);
        
        output.push_back(s[index]);
        solve(s,index+1,ans,output);
    }
